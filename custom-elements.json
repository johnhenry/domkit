    {
      "kind": "javascript-module",
      "path": "src/tabbed-ui/index.mjs",
      "declarations": [
        {
          "kind": "class",
          "description": "Tabs and panels from plain children, following the WAI-ARIA tabs\npattern: roles, ids, roving tabindex, and keyboard support are wired\nonto whatever markup you write.",
          "name": "TabbedUI",
          "cssProperties": [
            {
              "description": "Space between tabs (index.css).",
              "name": "--domkit-tab-gap"
            },
            {
              "description": "Padding inside each tab (index.css).",
              "name": "--domkit-tab-padding"
            },
            {
              "description": "Color of the selected-tab indicator and focus ring (index.css).",
              "name": "--domkit-tab-accent"
            },
            {
              "description": "Color of the line under the tab list (index.css).",
              "name": "--domkit-tab-border"
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "#observer",
              "privacy": "private",
              "default": "new MutationObserver(() => this.#sync())"
            },
            {
              "kind": "field",
              "name": "#index",
              "privacy": "private",
              "type": {
                "text": "number"
              },
              "default": "-1"
            },
            {
              "kind": "field",
              "name": "#syncing",
              "privacy": "private",
              "type": {
                "text": "boolean"
              },
              "default": "false"
            },
            {
              "kind": "field",
              "name": "tabList",
              "description": "The tab list: the child with role=\"tablist\", else the first element child.",
              "type": {
                "text": "Element | null"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "tabs",
              "description": "The tabs, in order.",
              "type": {
                "text": "Element[]"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "panels",
              "description": "The panels, in order (every element child except the tab list).",
              "type": {
                "text": "Element[]"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "selectedIndex",
              "description": "Index of the selected tab. Setting it does not fire `change`.",
              "type": {
                "text": "number"
              }
            },
            {
              "kind": "field",
              "name": "manual",
              "description": "With `manual`, arrow keys move focus and Enter/Space selects.",
              "type": {
                "text": "boolean"
              }
            },
            {
              "kind": "method",
              "name": "#observe",
              "privacy": "private"
            },
            {
              "kind": "method",
              "name": "#sync",
              "privacy": "private"
            },
