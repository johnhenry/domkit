              "kind": "method",
              "name": "#isDisabled",
              "privacy": "private",
              "parameters": [
                {
                  "name": "tab"
                }
              ]
            },
            {
              "kind": "method",
              "name": "#select",
              "privacy": "private",
              "parameters": [
                {
                  "name": "index"
                },
                {
                  "name": "{ user, focus = false, force = false }"
                }
              ]
            },
            {
              "kind": "method",
              "name": "#tabFor",
              "privacy": "private",
              "parameters": [
                {
                  "name": "target"
