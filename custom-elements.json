                }
              ]
            }
          ],
          "events": [
            {
              "name": "change",
              "type": {
                "text": "Event"
              },
              "description": "The user selected a different tab (click or keyboard). Not fired for script changes."
            }
          ],
          "attributes": [
            {
              "name": "selected-index",
              "type": {
                "text": "number"
              },
              "description": "Index of the selected tab. Reflects the current selection."
            },
            {
              "name": "manual",
              "type": {
                "text": "boolean"
              },
              "description": "Arrow keys move focus only; Enter/Space selects (manual activation)."
            }
          ],
          "superclass": {
            "name": "HTMLElement"
          },
          "tagName": "tabbed-ui",
          "customElement": true,
          "summary": "Accessible tabs and panels from plain children."
