{
  "name": "@johnhenry/domkit",
  "version": "0.0.9",
  "description": "Small, independent custom elements and DOM utilities -- drop-in UI widgets, media-query-driven containers, persisted UI state, declarative loaders -- shipped as source, no build step.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-custom-data.json": "./vscode.html-custom-data.json",
    "./*.mjs": "./src/*.mjs",
    "./*.css": "./src/*.css",
    "./*": "./src/*/index.mjs"
  },
  "files": [
    "src/",
    "custom-elements.json",
    "vscode.html-custom-data.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "test": "npm run check && npm run test:dom",
    "check": "node scripts/check-syntax.mjs && node scripts/check-links.mjs && eslint . && tsc -p test/types",
    "test:dom": "node --test \"test/*.test.mjs\"",
    "test:browser": "playwright test",
    "manifest": "cem analyze && node scripts/manifest-outputs.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "keywords": [
    "html",
    "dom",
    "web-components",
    "custom-elements",
    "no-build",
    "accessibility",
    "forms"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/domkit.git"
  },
  "homepage": "https://opensource.johnhenry.me/domkit/",
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2"
  }
}
